<idea-plugin>
    <id>ru.student.cpp-templates</id>
    <name>CppTemplates</name>
    <vendor>Student</vendor>

    <description><![CDATA[
        Учебный плагин для CLion.
        Добавляет команды вставки шаблонов C++:
        функции main, цикла for и класса.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.clion</depends>

    <actions>
        <action
                id="ru.student.cpptemplates.InsertMainAction"
                class="ru.student.cpptemplates.InsertMainAction"
                text="Insert C++ Main"
                description="Insert a C++ main function template">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="control alt shift T"
                               second-keystroke="M"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action
                id="ru.student.cpptemplates.InsertForAction"
                class="ru.student.cpptemplates.InsertForAction"
                text="Insert C++ For Loop"
                description="Insert a C++ for loop template">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="control alt shift T"
                               second-keystroke="F"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action
                id="ru.student.cpptemplates.InsertClassAction"
                class="ru.student.cpptemplates.InsertClassAction"
                text="Insert C++ Class"
                description="Insert a C++ class template">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="control alt shift T"
                               second-keystroke="C"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action
                id="ru.student.cpptemplates.CheckLabNamingAction"
                class="ru.student.cpptemplates.CheckLabNamingAction"
                text="Check Lab Naming"
                description="Check C++ identifier names against lab rules">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="control alt shift T"
                               second-keystroke="N"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

    </actions>
</idea-plugin>